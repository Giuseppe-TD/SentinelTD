# Copy to .env and fill the required secrets. Never commit .env.
# Compose builds DATABASE_URL; set it only for direct/non-Compose use.
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
ADMIN_PASSWORD=
JWT_SECRET=
JWT_HOURS=12
TOTP_ISSUER=Panopticon
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Panopticon
WEBAUTHN_ORIGIN=
SHOOTER_URL=http://shooter:8090
SCHEDULER_TICK_MINUTES=5
SCREENSHOT_EVERY_HOURS=12
OFFLINE_CONFIRM_CHECKS=3
OFFLINE_RETRY_DELAY_SECONDS=120
AUTOUPDATE_ENABLED=false
AUTOUPDATE_HOUR=3
AUTOUPDATE_PAUSE_SECONDS=5
AUTOUPDATE_SITE_STAGGER_SECONDS=30
AUTOUPDATE_RETRY_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Sentinel TD
REPORT_TO=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_FAILURES=true
TELEGRAM_NOTIFY_OFFLINE=true
TELEGRAM_NOTIFY_SUMMARY=true
KEV_FEED_URL=https://raw.githubusercontent.com/BenjiTrapp/cisa-known-vuln-scraper/main/cisa-kev.json
VEL_FEED_URL=https://extensions.joomla.org/vel-feed
VEL_VERIFY_URL=https://extensions.joomla.org/vel-verify
SECURITY_USE_NVD=false
SECURITY_NVD_MAX_KEYWORDS=40
SECURITY_STATE_DIR=/tmp/panopticon-sec
POSTGRES_DB=panopticon
POSTGRES_USER=panopticon
POSTGRES_PASSWORD=
BIND_ADDRESS=127.0.0.1
HOST_PORT=8810
TZ=UTC
DEFAULT_UI_LANGUAGE=en
SHOTS_DIR=/data/screenshots
SHOT_WIDTH=1280
SHOT_HEIGHT=800
SHOT_QUALITY=72
SHOT_THUMB_WIDTH=360
SHOT_TIMEOUT_MS=25000
SHOT_SETTLE_MS=1800
SHOT_VIDEO_WAIT_MS=6000
